  "global_rules": [
    "Every channel must have a unique visual signature independent of its label.",
    "All signal art is generated at 160x120 using rectangles, lines, circles/polygons and sparse deterministic noise.",
    "TV programming remains on the CRT world surface and inherits perspective/depth/occlusion from Pass 16.",
    "Channel label is not required for visual distinction; QA thumbnails hide labels inside the signal image.",
    "Clue slots are structural hooks only in Pass 17; no narrative clue is activated yet.",
    "No Alternate reaction, voice playback, datamosh reset, or strike behavior."
  ],
  "references": [
    "pygame-ce pygame.draw: rect/polygon/circle/line primitives render directly to a Surface.",
    "pygame-ce Surface/blit: compose the low-resolution channel Surface before projecting it into the world.",
    "pygame-ce transform.scale: resize from the original 160x120 signal surface when needed."
  ]
}
