  "normalization": {
    "target_integrated_lufs": -16.0,
    "target_true_peak_dbtp": -1.5,
    "sample_rate_hz": 48000,
    "channels": 2,
    "format": "ogg_vorbis",
    "note": "Pass 32 finalization mix: louder than Pass 31/31.1 while retaining trimmed loop files."
  },
  "routing": {
    "main": "main/MCF28.ogg",
    "battle": {
      "purge": "battle/MCF12.ogg",
      "recovery": "battle/MCF18.ogg",
      "rescue": "battle/MCF22.ogg",
      "sovereign": "battle/MCF26.ogg"
